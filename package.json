{
  "name": "kinevault-track",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/comfortaa": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "2.117.2",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.18",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "minisearch": "7.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "expo-mcp": "~0.2.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "toqr": "^0.1.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "start:cloudflare": "node scripts/expo-cloudflare.mjs",
    "doctor:connection": "node scripts/expo-connect.mjs",
    "android": "expo start --android",
    "android:keyboard": "node scripts/android-keyboard.mjs",
    "assets:mascot": "node scripts/optimize-mascot.mjs",
    "foods:import": "python3 scripts/import-food-catalog.py",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts scripts/*.test.mjs",
    "test:browser": "node --test --test-concurrency=2 tests/*.browser.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "postinstall": "node scripts/apply-dependency-patches.mjs",
    "export:web": "expo export --platform web",
    "lint": "eslint src tests scripts supabase/functions eslint.config.mjs --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write src tests scripts supabase/functions eslint.config.mjs package.json app.json tsconfig.json .prettierrc.json .github/workflows/check.yml",
    "format:check": "prettier --check src tests scripts supabase/functions eslint.config.mjs package.json app.json tsconfig.json .prettierrc.json .github/workflows/check.yml"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "query-string": {
      ".": "7.1.3",
      "decode-uri-component": "0.5.0"
    },
    "@expo/ngrok": {
      "uuid": "11.1.1"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true,
  "type": "module"
}

{
  "expo": {
    "name": "KineVault Track",
    "slug": "kinevault-track",
    "version": "1.0.0",
    "icon": "./assets/branding/icon.png",
    "orientation": "portrait",
    "scheme": "kinevaulttrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kinevault.track",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png",
        "backgroundColor": "#f8f2e3"
      },
      "permissions": ["android.permission.health.READ_STEPS"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "package": "com.kinevault.track"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      ["expo-router", { "asyncRoutes": { "web": false } }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#eef2f6",
          "image": "./assets/branding/splash-light.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#10161c",
            "image": "./assets/branding/splash-dark.png"
          },
          "android": {
            "image": "./assets/branding/splash-android.png",
            "imageWidth": 200,
            "dark": {
              "backgroundColor": "#10161c",
              "image": "./assets/branding/splash-android.png"
            }
          }
        }
      ],
      "expo-image",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KineVault to use the camera to scan food barcodes and take profile or progress photos.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KineVault to choose profile and progress photos from your photo library.",
          "cameraPermission": "Allow KineVault to use the camera to scan food barcodes and take profile or progress photos.",
          "microphonePermission": false
        }
      ],
      ["expo-secure-store", { "faceIDPermission": false }],
      "expo-sharing",
      "./plugins/with-local-notifications-only.cjs",
      "./plugins/with-gradle-memory.cjs",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#3a6a96"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow KineVault to read your step count so Home can show your daily steps."
        }
      ],
      "react-native-health-connect",
      ["expo-build-properties", { "android": { "minSdkVersion": 26 } }],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

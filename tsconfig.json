{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Defers the React Native strict TypeScript API. RN 0.90 drops this opt-out; see TODO.md.
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "allowImportingTsExtensions": true,
    "types": ["node", "react", "expo/types"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "supabase/functions/**", "dist", "dist-native"]
}
